LANDLORD_WALLET=
TENANT_WALLET=

# --- Contract 5: every key the demo uses. Leave blank to run on mocks. ---
# The backend boots with this file empty: BACKEND_MODE defaults to mock, which
# generates throwaway keys per process, keeps a virtual USDC reserve, and
# co-signs without broadcasting. Copy to .env (git-ignored) and fill in to go live.

# --- RPC (shared by backend and scripts, backend/src/rpc.ts) ---
SOLANA_CLUSTER=devnet
HELIUS_API_KEY=                 # set this and the Helius URL is built for you
RPC_URL=                        # used only when HELIUS_API_KEY is empty; defaults to the public devnet endpoint
RPC_MAX_RETRIES=8               # the public endpoint 429s mid proof-plan, so backoff is always on
RPC_RETRY_BASE_MS=500
RPC_RETRY_MAX_MS=20000

# --- backend ---
PORT=8787
BACKEND_MODE=mock               # mock | live  (live requires the keys below and refuses AUTH_MODE=mock)
AUTH_MODE=mock                  # mock | wallet | hmac  — wallet = sign-in with a wallet signature (required for live); mock only changes how a session is issued, never how it is verified
SESSION_SECRET=                 # HMAC secret; a random per-process secret is used when blank
SESSION_TTL_SECONDS=3600
ADMIN_TOKEN=                    # guards /api/treasury/wrap and /credit-reserve; those routes are disabled while blank
CORS_ORIGIN=*

# --- keys: four separate keys, never the same file (docs/contracts/treasury.md) ---
# Each accepts a path to a Solana CLI keypair file, an inline JSON byte array, or a base58 secret.
FEE_PAYER_KEYPAIR=              # sponsor: pays transaction fees and nothing else
ATTESTATION_ISSUER_KEYPAIR=     # KYC issuer; MUST differ from FEE_PAYER_KEYPAIR
TREASURY_KEYPAIR=               # rUSDC mint + freeze authority, and the only key that funds rent
#                                 the fourth key is the auditor ElGamal seed, below

# --- rUSDC (scripts/make-rusdc.ts writes these) ---
RUSDC_MINT=
RUSDC_DECIMALS=6
RUSDC_AUDITOR_IKM=              # SECRET: 32-byte base64 seed for the auditor ElGamal + AES keys. Never ship to the app
RUSDC_AUDITOR_ELGAMAL_PUBKEY=   # derived from the seed; recorded for reference
USDC_RESERVE_MINT=              # devnet test USDC; blank in mock mode
USDC_RESERVE_TOKEN_ACCOUNT=     # treasury-owned reserve account backing the peg

# --- appraiser invitations (D2, docs/contracts/dispute-mediation.md §4, §10) ---
# There is no appraiser registry and no backend-held appraiser key: the parties agree on a company
# name on chain, this backend e-mails that company an invitation, and the appraiser signs the verdict
# with a wallet of their own. Nothing here can bind an appraiser or move a deposit.
INVITE_EMAIL_SENDER=            # console | none. Blank = console in mock mode, none in live mode
INVITE_TTL_SECONDS=             # blank = the program's SELECTION_WINDOW_SECS; always clamped to selection_deadline

# --- sponsor caps (POST /api/sponsor) ---
SPONSOR_MAX_TX_BYTES=1232
SPONSOR_MAX_INSTRUCTIONS=16
SPONSOR_MAX_COMPUTE_UNITS=400000
SPONSOR_MAX_CU_PRICE_MICROLAMPORTS=10000
SPONSOR_MAX_FEE_LAMPORTS=200000
SPONSOR_MAX_RENT_LAMPORTS=50000000      # cap on what one confidential-account setup may debit the treasury
SPONSOR_MAX_PER_WALLET_PER_HOUR=20
SPONSOR_MAX_GLOBAL_PER_HOUR=500
SPONSOR_MAX_LAMPORTS_PER_WALLET_PER_DAY=2000000
SPONSOR_MAX_LAMPORTS_GLOBAL_PER_DAY=50000000

# --- treasury-cosigned rent payment + rent dust (docs/contracts/pay.md) ---
RENT_PAYMENT_MAX_CONTEXT_LAMPORTS=3000000     # per proof context-state account (real ones: 1.47M, 2.61M, 2.16M on devnet)
RENT_PAYMENT_MAX_CONTEXT_SPACE=400
RENT_PAYMENT_MAX_CREATE_ACCOUNTS=1            # per transaction (the plan creates one per transaction)
RENT_PAYMENT_MAX_SPEND_LAMPORTS=4000000       # most the treasury may be down on one transaction, by simulation
RENT_PAYMENT_MAX_PER_WALLET_PER_HOUR=30
RENT_PAYMENT_MAX_GLOBAL_PER_HOUR=300
RENT_PAYMENT_MAX_LAMPORTS_PER_WALLET_PER_DAY=30000000   # a payment books ~6.3M; this is also the bound on stranded/stolen rent per wallet
RENT_PAYMENT_MAX_LAMPORTS_GLOBAL_PER_DAY=100000000
RENT_DUST_MAX_GLOBAL_PER_HOUR=60              # wallets granted the rent of their Application + Profile
RENT_DUST_MAX_LAMPORTS_GLOBAL_PER_DAY=100000000

# --- providers (workstreams D and E) ---
KYC_PROVIDER=mock               # mock | sumsub
# ALLOW_MOCK_KYC=devnet         # live + mock KYC only on devnet (needs SOLANA_CLUSTER=devnet; genesis-checked at boot)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
ONRAMP_PROVIDER=mock            # mock | stripe  (Stripe test mode only)
OFFRAMP_PROVIDER=mock           # mock — a real cash-out settles on mainnet; the payout screen is a stage prop
STRIPE_SECRET_KEY=              # sk_test_..., server-only. Required when ONRAMP_PROVIDER=stripe
STRIPE_WEBHOOK_SECRET=          # whsec_..., from `stripe listen` or the dashboard. Required when ONRAMP_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=         # pk_test_... (unused: the app never talks to Stripe directly, only the hosted page does)
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300    # how stale a signed webhook timestamp may be before it is a replay
DEMO_PLN_PER_USDC=4.30          # fixed demo rate, shown as illustrative. Floored when converting, never rounded up
ONRAMP_MIN_PLN=10               # per checkout
ONRAMP_MAX_PLN=5000             # per checkout
ONRAMP_MAX_USDC_PER_WALLET_PER_DAY=2000   # whole USDC a single wallet may be credited in a rolling day
OFFRAMP_MAX_USDC_PER_WALLET_PER_DAY=2000
BACKEND_URL=                    # public https origin of this backend (e.g. https://relstate-backend.fly.dev); blank = http://localhost:PORT. Needed for the mock KYC/checkout links when hosted
APP_URL=http://localhost:5173   # where the hosted checkout sends the user back; the return path lives in the hash
# MoneyGram is parked (docs/contracts/moneygram.md)

# app (app/.env.local): VITE_RPC, VITE_API, VITE_EMBEDDED_WALLET_APP_ID
