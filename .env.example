LANDLORD_WALLET=
TENANT_WALLET=

# --- Contract 5: every key the demo uses. Leave blank to run on mocks. ---
# The backend boots with this file empty: BACKEND_MODE defaults to mock, which
# generates throwaway keys per process, keeps a virtual USDC reserve, and
# co-signs without broadcasting. Copy to .env (git-ignored) and fill in to go live.

# --- RPC (shared by backend and scripts, backend/src/rpc.ts) ---
SOLANA_CLUSTER=devnet
HELIUS_API_KEY=                 # set this and the Helius URL is built for you
RPC_URL=                        # used only when HELIUS_API_KEY is empty; defaults to the public devnet endpoint
RPC_MAX_RETRIES=8               # the public endpoint 429s mid proof-plan, so backoff is always on
RPC_RETRY_BASE_MS=500
RPC_RETRY_MAX_MS=20000

# --- backend ---
PORT=8787
BACKEND_MODE=mock               # mock | live  (live requires the keys below and refuses AUTH_MODE=mock)
AUTH_MODE=mock                  # mock | hmac  — mock only changes how a session is issued, never how it is verified
SESSION_SECRET=                 # HMAC secret; a random per-process secret is used when blank
SESSION_TTL_SECONDS=3600
ADMIN_TOKEN=                    # guards /api/treasury/wrap and /credit-reserve; those routes are disabled while blank
CORS_ORIGIN=*

# --- keys: four separate keys, never the same file (docs/contracts/treasury.md) ---
# Each accepts a path to a Solana CLI keypair file, an inline JSON byte array, or a base58 secret.
FEE_PAYER_KEYPAIR=              # sponsor: pays transaction fees and nothing else
ATTESTATION_ISSUER_KEYPAIR=     # KYC issuer; MUST differ from FEE_PAYER_KEYPAIR
TREASURY_KEYPAIR=               # rUSDC mint + freeze authority, and the only key that funds rent
#                                 the fourth key is the auditor ElGamal seed, below

# --- rUSDC (scripts/make-rusdc.ts writes these) ---
RUSDC_MINT=
RUSDC_DECIMALS=6
RUSDC_AUDITOR_IKM=              # SECRET: 32-byte base64 seed for the auditor ElGamal + AES keys. Never ship to the app
RUSDC_AUDITOR_ELGAMAL_PUBKEY=   # derived from the seed; recorded for reference
USDC_RESERVE_MINT=              # devnet test USDC; blank in mock mode
USDC_RESERVE_TOKEN_ACCOUNT=     # treasury-owned reserve account backing the peg

# --- sponsor caps (POST /api/sponsor) ---
SPONSOR_MAX_TX_BYTES=1232
SPONSOR_MAX_INSTRUCTIONS=16
SPONSOR_MAX_COMPUTE_UNITS=400000
SPONSOR_MAX_CU_PRICE_MICROLAMPORTS=10000
SPONSOR_MAX_FEE_LAMPORTS=200000
SPONSOR_MAX_RENT_LAMPORTS=50000000      # cap on what one confidential-account setup may debit the treasury
SPONSOR_MAX_PER_WALLET_PER_HOUR=20
SPONSOR_MAX_GLOBAL_PER_HOUR=500
SPONSOR_MAX_LAMPORTS_PER_WALLET_PER_DAY=2000000
SPONSOR_MAX_LAMPORTS_GLOBAL_PER_DAY=50000000

# --- providers (workstreams D and E) ---
KYC_PROVIDER=mock               # mock | sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
ONRAMP_PROVIDER=mock            # mock | ramp
RAMP_HOST_API_KEY=
OFFRAMP_PROVIDER=mock           # mock

# app (app/.env.local): VITE_RPC, VITE_API, VITE_EMBEDDED_WALLET_APP_ID
