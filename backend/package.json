{
  "name": "relstate-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec 'test/*.test.ts'",
    "test:devnet": "node --env-file-if-exists=../.env --env-file-if-exists=.env --test --test-reporter=spec --test-timeout=600000 'test/*.devnet.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana/kit": "^8.4.0",
    "@solana/zk-sdk": "^0.5.3",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.7.3"
  }
}
