{
    "compilerOptions": {
        "types": [
            "mocha",
            "chai",
            "node"
        ],
        "typeRoots": [
            "./node_modules/@types"
        ],
        "lib": [
            "es2022"
        ],
        "module": "nodenext",
        "target": "es2022",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "tests",
        "scripts"
    ]
}
