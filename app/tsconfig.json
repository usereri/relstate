{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@target/idl/relstate.json": ["../target/idl/relstate.json", "./idl/relstate.json"],
      "@target/types/relstate": ["../target/types/relstate", "./idl/relstate"],
      "@target/*": ["../target/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
